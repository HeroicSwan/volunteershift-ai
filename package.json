{
  "name": "volunteer-matcher",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/runner.ts",
    "eval:verbose": "tsx evals/runner.ts --verbose",
    "eval:case": "tsx evals/runner.ts --case",
    "eval:adversarial": "tsx evals/adversarial-runner.ts --phase final",
    "eval:adversarial:baseline": "tsx evals/adversarial-runner.ts --phase baseline",
    "icons": "node scripts/make-icons.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "electron .",
    "dist": "npm run icons && npm run build:desktop && electron-builder",
    "dist:win": "npm run icons && npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run icons && npm run build:desktop && electron-builder --mac",
    "dist:linux": "npm run icons && npm run build:desktop && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/epilogue": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
